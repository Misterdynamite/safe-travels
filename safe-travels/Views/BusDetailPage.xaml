<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="safe_travels.Views.BusDetailPage"
             Title="Bus Stop">

    <VerticalStackLayout Padding="20" Spacing="8">
        <SearchBar x:Name="TripSearchBar"
                   Placeholder="Search buses..."
                   TextChanged="OnSearchTextChanged"
                   HorizontalOptions="CenterAndExpand" />
        <Picker x:Name="FilterPicker"
                Title="Filter trips"
                HorizontalOptions="FillAndExpand">
            <Picker.Items>
                <x:String>All</x:String>
                <x:String>Arriving Soon</x:String>
                <x:String>Favorites</x:String>
            </Picker.Items>
        </Picker>
        <HorizontalStackLayout Spacing="10">
            <Button x:Name="SaveStopButton"
                    Text="Save Stop"
                    Clicked="OnSaveStopClicked"
                    HorizontalOptions="End" />
        </HorizontalStackLayout>
        <Border Background="#f2f2f2" StrokeShape="RoundRectangle 12" Padding="23">
            <VerticalStackLayout>
                <Label Text="{Binding StopName}"
                       FontSize="24"
                       FontAttributes="Bold"/>
                <Label Text="{Binding StopId, StringFormat='Stop ID: {0}'}"
                       FontSize="14"
                       TextColor="Gray"/>
            </VerticalStackLayout>
        </Border>

        <Label Text="Upcoming Buses" FontSize="18" FontAttributes="Bold"/>

        <CollectionView x:Name="BusCollection"
                ItemsSource="{Binding Trips}"
                SelectionMode="Single"
                SelectionChanged="OnBusSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" StrokeShape="RoundRectangle 8" Margin="0,4" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="{Binding attributes.stopHeadSign}" FontSize="16"/>
                            <Label Text="{Binding attributes.routeId}" FontSize="16"/>
                            <Label Text="{Binding attributes.arrivalTime}" FontSize="14" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>