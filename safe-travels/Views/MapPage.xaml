<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="safe_travels.Views.MapPage"
             Title="Map">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings"
                     SemanticProperties.Description="Settings"
                     SemanticProperties.Hint="Open to the Settings Page"
                     Clicked="OnSettingsClicked"
                     Priority="0"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- Normal view with map and horizontal favorites -->
        <Grid x:Name="NormalView" RowDefinitions="Auto,*,Auto">
            <VerticalStackLayout Grid.Row="0" Padding="0,0,0,4">
                <Picker x:Name="StopModePicker"
                        Title="Show stops by..."
                        SemanticProperties.Description="Tap to choose how to view Stops"
                        SelectedIndexChanged="OnStopModeChanged"
                        Margin="10">
                    <Picker.Items>
                        <x:String>Nearby Stops</x:String>
                        <x:String>Search by Name</x:String>
                    </Picker.Items>
                </Picker>

                <SearchBar x:Name="StopSearchBar"
                           SemanticProperties.Description="Stop Search Bar"
                           Placeholder="Search for a stop..."
                           IsVisible="False"
                           SearchButtonPressed="OnStopSearch" />

                <Button Text="Journey Planner"
                        Margin="10,0,10,0"
                        Clicked="OnJourneyPlannerClicked"
                        HorizontalOptions="FillAndExpand" />
            </VerticalStackLayout>

            <maps:Map x:Name="StopMap"
                      MapType="Street"
                      IsShowingUser="True"
                      Grid.Row="1"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand" />

            <BoxView Grid.Row="2" HeightRequest="1" Color="#DDDDDD" VerticalOptions="Start" />

            <CollectionView x:Name="FavoriteStopsCollection"
                            Grid.Row="2"
                            ItemsLayout="HorizontalList"
                            SelectionMode="Single"
                            HeightRequest="80"
                            Margin="10"
                            SelectionChanged="OnFavoriteStopSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundColor}" StrokeShape="RoundRectangle 8" Margin="4" Padding="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding DisplayLabel}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryTextColor}"
                                       LineBreakMode="WordWrap"
                                       SemanticProperties.Description="{Binding DisplayLabel}" />
                                <Label Text="{Binding stopId}" FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Accessibility view (alternate layout) -->
        <ScrollView x:Name="AccessibilityView"
                    IsVisible="False"
                    Padding="2"
                    BackgroundColor="{DynamicResource PageBackgroundColor}">
            <VerticalStackLayout Spacing="16">
                <Label Text="Accessibility Mode Active"
                       FontSize="25"
                       FontAttributes="Bold"
                       SemanticProperties.Description="Accessibility mode is active"
                       HorizontalOptions="Center" />

                <Label Text="Map view hidden for screen reader users.&#10;Use buttons below to navigate."
                       FontSize="16"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="Map view hidden for screen reader users.Use buttons below to navigate." />

                <Button Text="Search Stops by Name"
                        FontSize="25"
                        FontAttributes="Bold"
                        HeightRequest="60"
                        WidthRequest="320"
                        CornerRadius="12"
                        Clicked="OnSearchStopsButtonClicked"
                        SemanticProperties.Description="Search stops by name" />

                <VerticalStackLayout x:Name="AccessibleSearchSection"
                     IsVisible="False"
                     Spacing="10"
                     WidthRequest="320"
                     HorizontalOptions="Center">

                    <Label Text="Enter Stop Name"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="Enter the stop name to search" />

                    <Entry x:Name="AccessibleSearchEntry"
                           Placeholder="Type a stop name..."
                           FontSize="22"
                           HeightRequest="60"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           Completed="OnAccessibleSearchCompleted"
                           SemanticProperties.Description="Text field to enter the stop name" />

                    <CollectionView x:Name="AccessibleSearchResults"
                                    IsVisible="False"
                                    SelectionMode="Single"
                                    SelectionChanged="OnAccessibleSearchResultSelected"
                                    SemanticProperties.Description="List of stops matching your search">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundColor}"
                                        StrokeShape="RoundRectangle 8"
                                        Margin="4"
                                        Padding="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding stopName}"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               SemanticProperties.Description="{Binding stopName}" />
                                        <Label Text="{Binding stopId}"
                                               FontSize="18"
                                               TextColor="{DynamicResource SecondaryTextColor}" />  
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Button Text="Nearby Stops"
                        FontSize="25"
                        FontAttributes="Bold"
                        HeightRequest="60"
                        WidthRequest="320"
                        CornerRadius="12"
                        Clicked="OnNearbyStopsButtonClicked"
                        SemanticProperties.Description="Show nearby bus stops, Toggle to hide." />

                <!-- Vertical favorites list for accessibility view - NOW SCALED TO MATCH STOPS LIST -->
                <VerticalStackLayout Spacing="10"
                                     WidthRequest="300">
                    <Label Text="Favorite Stops"
                           FontSize="25"
                           FontAttributes="Bold"/>
                    <CollectionView x:Name="AccessibleFavoriteStops"
                                SelectionMode="Single"
                                SelectionChanged="OnFavoriteStopSelected"
                                SemanticProperties.Description="Saved favorite stops"
                                HeightRequest="200">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundColor}"
                                    StrokeShape="RoundRectangle 8"
                                    Margin="4"
                                    Padding="4">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding DisplayLabel}"
                                           FontSize="25"
                                           FontAttributes="Bold"
                                           SemanticProperties.Description="{Binding DisplayLabel}" />
                                        
                                    </VerticalStackLayout>
                                </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </VerticalStackLayout>
                <!-- Accessible stops list (batched via code-behind) -->
                <VerticalStackLayout Spacing="10"
                                     WidthRequest="300">
                    <Label Text="Stops Near You"
                           FontSize="25"
                           FontAttributes="Bold"/>
                    <CollectionView x:Name="AccessibleStopsList"
                                IsVisible="True"
                                SelectionMode="Single"
                                SelectionChanged="OnAccessibleStopSelected"
                                SemanticProperties.Description="List of bus stops">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundColor}"
                                    StrokeShape="RoundRectangle 8"
                                    Margin="4"
                                    Padding="4">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding stopName}"
                                           FontSize="25"
                                           FontAttributes="Bold"
                                           SemanticProperties.Description="{Binding stopName}"/>
                                    </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </VerticalStackLayout>
                <Button x:Name="ShowMoreButton"
                        Text="Show More Stops"
                        FontSize="25"
                        FontAttributes="Bold"
                        HeightRequest="60"
                        WidthRequest="320"
                        CornerRadius="12"
                        Clicked="OnShowMoreClicked"
                        SemanticProperties.Description="Load more nearby bus stops" />

                <Button Text="Journey Planner"
                        FontSize="25"
                        FontAttributes="Bold"

                        HeightRequest="60"
                        WidthRequest="320"
                        CornerRadius="12"
                        Clicked="OnJourneyPlannerClicked"
                        SemanticProperties.Description="Open journey planner" />

                <Button Text="Settings"
                        FontSize="25"
                        FontAttributes="Bold"
                        HeightRequest="60"
                        WidthRequest="320"
                        CornerRadius="12"
                        Clicked="OnSettingsClicked"
                        SemanticProperties.Description="Open settings page" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>