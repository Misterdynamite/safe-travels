<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="safe_travels.Views.JourneyPlannerPage"
    Title="Journey Planner"
    BackgroundColor="{DynamicResource CardBackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor= "{DynamicResource CardBackgroundColor}">
        <Grid x:Name="NormalView"
              RowDefinitions="Auto,*,Auto"
              IsVisible="True"
              BackgroundColor="{DynamicResource CardBackgroundColor}">
            <!-- 🔹 Main Content -->
            <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="15" ZIndex="2">

                <!-- Journey Section -->
                <Label Text="YOUR JOURNEY" FontSize="25" FontAttributes="Bold"/>
                <Label Text="Choose your journey" FontSize="20"/>

                <!-- Origin Input -->
                <Entry x:Name="OriginInput"
                   Placeholder="Enter origin address..."
                   TextColor="{DynamicResource SecondaryTextColor}"
                   TextChanged="OnOriginTextChanged"
                   Margin="0,5"/>

                <!-- Origin Suggestions -->
                <CollectionView x:Name="OriginSuggestionsView"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            HeightRequest="200"
                            ZIndex="10"
                            SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding display_name}"
                               Padding="10"
                               TextColor= "{DynamicResource SecondaryTextColor}"
                               BackgroundColor="{DynamicResource CardBackgroundColor}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOriginSuggestionChosen"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Destination Input -->
                <Entry x:Name="DestinationInput"
                   Placeholder="Enter destination address..."
                   TextColor="{DynamicResource SecondaryTextColor}"
                   TextChanged="OnDestinationTextChanged"
                   Margin="0,5"/>

                <!-- Destination Suggestions -->
                <CollectionView x:Name="DestinationSuggestionsView"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource CardBackgroundColor}"
                            HeightRequest="200"
                            ZIndex="10"
                            SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding display_name}"
                               Padding="10"
                               TextColor="Black"
                               BackgroundColor="White">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDestinationSuggestionChosen"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Journey Results -->
                <CollectionView x:Name="JourneyResults"
                            IsVisible="False">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding}" Padding="10" FontSize="19"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Plan Journey Button -->
                <Button Text="Plan Journey"
                    
                    TextColor="{DynamicResource SecondaryTextColor}"
                    FontAttributes="Bold"
                    Clicked="OnPlanJourneyClicked"
                    Margin="0,10"/>

            </VerticalStackLayout>
        </Grid>
        <ScrollView x:Name="AccessibilityView"
                    IsVisible="False"
                    Padding="25"
                    BackgroundColor="{DynamicResource CardBackgroundColor}">
            <VerticalStackLayout Spacing="20">

                <Label Text="Accessibility Mode Active"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="Accessibility mode is active" />

                <Label Text="Plan your journey with larger text and screen reader support."
                       FontSize="20"
                       TextColor="{DynamicResource SecondaryTextColor}"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="Instructions for accessibility users" />

                <Label Text="Enter Origin Address:"
                       FontSize="22"
                       FontAttributes="Bold"
                       SemanticProperties.Description="Enter the starting point of your journey" />
                <Entry x:Name="AccessibleOriginInput"
                       Placeholder="Enter origin address..."
                       FontSize="22"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       TextChanged="OnOriginTextChanged"
                       HeightRequest="60"
                       SemanticProperties.Description="Type the starting point for your trip" />

                <CollectionView x:Name="AccessibleOriginSuggestionsView"
                        IsVisible="False"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        HeightRequest="250"
                        SelectionMode="Single"
                        SemanticProperties.Description="List of suggested origin addresses">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="12"
                           Margin="6"
                           Padding="10"
                           BackgroundColor="{DynamicResource CardBackgroundColor}">
                                <Label Text="{Binding display_name}"
                               FontSize="22"
                               TextColor="{DynamicResource PrimaryTextColor}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOriginSuggestionChosen"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Enter Destination Address:"
                       FontSize="22"
                       FontAttributes="Bold"
                       SemanticProperties.Description="Enter the destination of your journey" />
                <Entry x:Name="AccessibleDestinationInput"
                       Placeholder="Enter destination address..."
                       FontSize="22"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       TextChanged="OnDestinationTextChanged"
                       HeightRequest="60"
                       SemanticProperties.Description="Type the destination for your trip" />
                <CollectionView x:Name="AccessibleDestinationSuggestionsView"
                        IsVisible="False"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        HeightRequest="250"
                        SelectionMode="Single"
                        SemanticProperties.Description="List of suggested destination addresses">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="12"
                           Margin="6"
                           Padding="10"
                           BackgroundColor="{DynamicResource CardBackgroundColor}">
                                <Label Text="{Binding display_name}"
                               FontSize="22"
                               TextColor="{DynamicResource PrimaryTextColor}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDestinationSuggestionChosen"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Plan Journey"
                        FontSize="24"
                        FontAttributes="Bold"
                        HeightRequest="80"
                        CornerRadius="15"
                        BackgroundColor="#B49BEB"
                        TextColor="Black"
                        Clicked="OnPlanJourneyClicked"
                        SemanticProperties.Description="Tap to plan your journey" />
                <ScrollView  HeightRequest="270"
                    IsVisible="True">
                <CollectionView x:Name="AccessibleJourneyResults"
                                IsVisible="True"
                                SelectionMode="None"
                                SemanticProperties.Description="Journey results in accessibility mode">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="12"
                                   BackgroundColor="{DynamicResource CardBackgroundColor}"
                                   Margin="4"
                                   Padding="10">
                                <Label Text="{Binding}"
                                       FontSize="22"
                                       TextColor="{DynamicResource PrimaryTextColor}" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </ScrollView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
