<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="safe_travels.Views.JourneyPlannerPage"
    Title="Journey Planner">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="White">


        <!-- 🔹 Top App Bar -->
        <Grid BackgroundColor="#F8F8F8" Padding="10" Row="0" ZIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Hamburger Menu -->
            <ImageButton Source="menu.png"
                         WidthRequest="24" HeightRequest="24"
                         BackgroundColor="Transparent"
                         Grid.Column="0"/>

            <!-- Title -->
            <Label Text="Journey Planner"
                   FontSize="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Grid.Column="1"/>

            <!-- Profile -->
            <ImageButton Source="profile.png"
                         WidthRequest="32" HeightRequest="32"
                         CornerRadius="16"
                         BackgroundColor="LightGray"
                         Grid.Column="2"/>
        </Grid>

        <!-- 🔹 Main Content -->
        <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="15" ZIndex="2">

            <!-- Journey Section -->
            <Label Text="YOUR JOURNEY" FontSize="18" FontAttributes="Bold"/>
            <Label Text="Choose your journey" FontSize="14" TextColor="Gray"/>

            <!-- Origin Input -->
            <Entry x:Name="OriginInput"
                   Placeholder="Enter origin address..."
                   TextColor="Black"
                   TextChanged="OnOriginTextChanged"
                   Margin="0,5"/>

            <!-- Origin Suggestions -->
            <CollectionView x:Name="OriginSuggestionsView"
                            IsVisible="False"
                            BackgroundColor="White"
                            HeightRequest="200"
                            ZIndex="10"
                            SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding display_name}"
                               Padding="10"
                               TextColor="Black"
                               BackgroundColor="White">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOriginSuggestionChosen"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Destination Input -->
            <Entry x:Name="DestinationInput"
                   Placeholder="Enter destination address..."
                   TextColor="Black"
                   TextChanged="OnDestinationTextChanged"
                   Margin="0,5"/>

            <!-- Destination Suggestions -->
            <CollectionView x:Name="DestinationSuggestionsView"
                            IsVisible="False"
                            BackgroundColor="White"
                            HeightRequest="200"
                            ZIndex="10"
                            SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding display_name}"
                               Padding="10"
                               TextColor="Black"
                               BackgroundColor="White">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDestinationSuggestionChosen"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Journey Results -->
            <CollectionView x:Name="JourneyResults"
                            IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding}" Padding="10" TextColor="Black"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Plan Journey Button -->
            <Button Text="Plan Journey"
                    BackgroundColor="#B49BEB"
                    TextColor="White"
                    Clicked="OnPlanJourneyClicked"
                    Margin="0,10"/>        

        </VerticalStackLayout>

        <!-- 🔹 Bottom Navigation -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="10" ColumnDefinitions="*,*,*" ZIndex="2">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                <Image Source="planner.png" HeightRequest="24"/>
                <Label Text="Journey Planner" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Image Source="live.png" HeightRequest="24"/>
                <Label Text="Live Tracking" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                <Image Source="saved.png" HeightRequest="24"/>
                <Label Text="Saved Journeys" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
