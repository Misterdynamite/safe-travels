<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:safe_travels"
             x:Class="safe_travels.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Card background -->
            <SolidColorBrush x:Key="CardBackgroundColor" 
                         Color="{AppThemeBinding Light=#f2f2f2, Dark=#1e1e1e}" />

            <!-- Text colors -->
            <SolidColorBrush x:Key="PrimaryTextColor" 
                         Color="{AppThemeBinding Light=Black, Dark=White}" />

            <SolidColorBrush x:Key="SecondaryTextColor" 
                         Color="{AppThemeBinding Light=Black, Dark=White}" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
